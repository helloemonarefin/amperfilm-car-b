---
// Page shell shared by every page: sticky bar, hero (page header, not a
// numbered section), the page's section array, footer and menu panel.
import Base from './Base.astro';
import Hero, { type HeroProps } from '../components/sections/Hero.astro';
import SectionRenderer from '../components/layout/SectionRenderer.astro';
import MenuPanel from '../components/layout/MenuPanel.astro';
import Footer from '../components/layout/Footer.astro';
import StickyBar from '../components/layout/StickyBar.astro';
import type { SectionEntry } from '../lib/sections';

export interface PageContent {
  title: string;
  /** Meta description, ≤ 160 characters. */
  description: string;
  hero: HeroProps;
  sections: SectionEntry[];
}
interface Props { page: PageContent }
const { page } = Astro.props;
---

<Base title={page.title} description={page.description}>
  <StickyBar />
  <Hero {...page.hero} />
  <main id="main">
    <SectionRenderer sections={page.sections} />
  </main>
  <Footer />
  <MenuPanel />
</Base>
