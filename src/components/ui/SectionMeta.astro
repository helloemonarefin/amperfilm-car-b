---
// Section meta bar — DESIGN_SYSTEM §6: full width, 41 tall, top border,
// padding 24/side/0/side, `(0n)` index left (Medium) + label right, both
// `meta` in text-tertiary. The index is generated from the page's section
// order (lib/sections.ts) — never typed.
interface Props {
  /** 1-based position among the page's numbered sections; omit for none. */
  index?: number;
  label?: string;
  class?: string;
}
const { index, label, class: className } = Astro.props;
---

<div class:list={['section-meta t-meta', className]}>
  {index != null ? <span class="t-medium" data-reveal>({String(index).padStart(2, '0')})</span> : <span />}
  {label && <span class="t-medium" data-reveal>{label}</span>}
</div>
