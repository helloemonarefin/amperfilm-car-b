  tint:            { view: 20, stroke: 1.6, body: '<path d="M2.91667 15L7.5 7.91667C7.83333 7.41667 8.33333 7.08333 9 7.08333H15.8333C16.1649 7.08333 16.4828 7.21503 16.7172 7.44945C16.9516 7.68387 17.0833 8.00181 17.0833 8.33333V15H2.91667Z"/><path d="M10.4167 9.58333L8.33333 12.9167M13.75 9.58333L11.6667 12.9167"/><path d="M6.66667 4.58333C6.66667 5.50381 5.92047 6.25 5 6.25C4.07953 6.25 3.33333 5.50381 3.33333 4.58333C3.33333 3.66286 4.07953 2.91667 5 2.91667C5.92047 2.91667 6.66667 3.66286 6.66667 4.58333Z"/>' },
