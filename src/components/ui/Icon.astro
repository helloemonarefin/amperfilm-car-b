} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Rendered size in px; defaults to the Figma frame size. */
  size?: number;
  /** Accessible name when the icon is the only content of its control. */
  label?: string;
  class?: string;
}

const { name, size, label, class: className } = Astro.props;
const icon = icons[name];
const px = size ?? icon.view;
---

<svg
  class:list={['icon', className]}
  width={px}
  height={px}
  viewBox={`0 0 ${icon.view} ${icon.view}`}
  fill="none"
  stroke="currentColor"
  stroke-width={icon.stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>

<style>
  .icon { flex: none; }
  .icon :global(path) { vector-effect: non-scaling-stroke; }
</style>
