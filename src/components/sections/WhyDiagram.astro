---
// Why EV-only diagram — DESIGN_SYSTEM §7, Figma 337:188 (1440 × 930).
// Desktop (≥ 1360): three problem points on the left (`h3` + `small` + soft
// tag), each linked by a 1px line to a 10px ink dot on the dotted 860 circle.
// Inside the circle: a blue radial glow and the "Solution" block.
// The circle is anchored to the frame's right edge (as in Figma); the lines
// stretch with the width, so the canvas needs ≥ 1360 to keep every line visible.
// Below 1360 (proposed, §7): the circle becomes a smaller block with the
// Solution inside, and the points stack underneath (3 across from 768).
// Figma's "Car photo circle" layer is an empty (transparent) image: omitted.
import { Image } from 'astro:assets';
import Pill from '../ui/Pill.astro';
import ring from '../../assets/images/home/diagram-ring.png';

export interface WhyProps {
  /** Exactly 3 points (the dots sit at fixed angles on the circle). */
  points: { title: string; text: string; tag: string }[];
  solution: {
    label: string;
    /** `h3-lg`, one entry per line, ≤ 2 lines of ≤ 20 characters. */
    title: string[];
    /** ≤ 120 characters. */
    text: string;
  };
}
const { points, solution } = Astro.props as WhyProps;
---

<section class="why" aria-labelledby="why-title">
  <div class="why__frame frame">
    <div class="why__visual" data-reveal>
      <Image class="why__ring" src={ring} alt="" widths={[860, 1720]} sizes="(min-width: 1360px) 860px, 560px" aria-hidden="true" />
      <span class="glow glow--diagram why__glow" aria-hidden="true"></span>
      <!-- Liquid glow (owner, 2026-11-17): replaces the CSS glow when JS runs
           and motion is allowed. -->
      <canvas class="why__liquid" width="300" height="300" aria-hidden="true" data-liquid></canvas>
      <div class="why__solution">
        <p class="t-meta t-medium c-strong" data-reveal>{solution.label}</p>
        <h2 id="why-title" class="t-h3-lg">{solution.title.map((l, i) => <>{i > 0 && ' '}<span class="why__title-line" data-reveal>{l}</span></>)}</h2>
        <p class="t-body-sm c-secondary" data-reveal>{solution.text}</p>
      </div>
    </div>

    <!-- Connector lines + dots (desktop canvas only). They sit at fixed angles
         on the circle; the points beside them are positioned separately. -->
    <div class="why__links" aria-hidden="true">
      {points.map(() => <span class="why__link" data-reveal></span>)}
    </div>

    <ul class="why__points" role="list">
      {points.map((p) => (
        <li class="why__point">
          <h3 class="t-h3" data-reveal>{p.title}</h3>
          <p class="t-small c-secondary" data-reveal>{p.text}</p>
          <Pill variant="soft" data-reveal>{p.tag}</Pill>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why__title-line { display: block; }
  .why { overflow: hidden; padding-block: var(--space-18) var(--section-pad-bottom); }
  .why__frame { position: relative; padding-inline: var(--side-pad); }

  /* ---- Stacked layout (< 1360) ---- */
  .why__visual {
    position: relative;
    width: min(100%, 35rem);
    aspect-ratio: 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }
  .why__visual :global(.why__ring) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    /* Slow continuous turn of the dotted ring (owner, 2026-11-17). Stops
       under reduced motion via the global kill switch. */
    animation: spin var(--m-ring-time) linear infinite;
  }
  .why__glow {
    inset: var(--diagram-glow-inset);
    opacity: 0.55;
  }
  /* Covers the whole circle so moving blobs never hit the canvas edge;
     the base glow is drawn at its Figma size (700 of 860) inside it. */
  .why__liquid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    filter: blur(calc(var(--glow-diagram-blur) / 2));
    pointer-events: none;
  }
  .why__visual.is-liquid .why__liquid { display: block; }
  .why__visual.is-liquid .why__glow { display: none; }
  .why__solution {
    position: relative;
    display: flex; flex-direction: column; gap: var(--space-3);
    width: 64%;
    text-align: center;
  }
  /* Narrow phones: wider text so the title lines never break to one word. */
  @media (max-width: 479px) { .why__solution { width: 88%; } }
  .why__points {
    display: grid; gap: var(--space-10);
    margin-top: var(--space-14);
  }
  .why__point { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .why__links { display: none; }
  @media (min-width: 768px) {
    .why__points { grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  }

  /* ---- Figma canvas (≥ 1360) ---- */
  @media (min-width: 1360px) {
    .why { padding: 0; }
    .why__frame { height: var(--diagram-h); padding: 0; container-type: inline-size; }
    .why__visual {
      position: absolute; top: var(--diagram-circle-y); right: 0;
      width: var(--diagram-circle); margin: 0; display: block;
    }
    .why__solution {
      position: absolute; left: var(--diagram-solution-x); top: var(--diagram-solution-y);
      width: var(--diagram-solution-w);
      gap: var(--diagram-solution-gap);
      text-align: left;
    }
    /* Points: x 40, tops 156 / 410 / 665 (Figma v2.1). */
    .why__points { position: static; margin: 0; display: block; }
    .why__point { position: absolute; left: var(--diagram-points-x); width: var(--diagram-point-w); }
    .why__point:nth-child(1) { top: var(--diagram-point-y1); }
    .why__point:nth-child(2) { top: var(--diagram-point-y2); }
    .why__point:nth-child(3) { top: var(--diagram-point-y3); }

    /* Lines: start at x 461, end at their dot on the circle. Dot position =
       circle centre + (dx, dy); the circle is anchored to the right edge. */
    .why__links { display: block; }
    .why__link {
      --dx: -350px; --dy: -250px;
      position: absolute;
      top: calc(var(--diagram-circle-y) + var(--diagram-circle) / 2 + var(--dy));
      left: var(--diagram-line-x);
      width: calc(100cqw - var(--diagram-circle) / 2 + var(--dx) - var(--diagram-line-x));
      height: 1px;
      background: var(--border-line);
    }
    .why__link:nth-child(2) { --dx: -430px; --dy: 0px; }
    .why__link:nth-child(3) { --dy: 250px; }
    .why__link::after {
      content: '';
      position: absolute; right: calc(var(--diagram-dot) / -2); top: calc(var(--diagram-dot) / -2 + 0.5px);
      width: var(--diagram-dot); height: var(--diagram-dot);
      border-radius: var(--radius-pill);
      background: var(--text-primary);
    }
  }
</style>

<script>
  // Liquid glow (owner, 2026-11-17). A soft blue base glow plus four
  // "liquid" blobs drawn on a small canvas (CSS blur makes them soft).
  // Idle: the blobs drift slowly around the centre. Hover: each blob is
  // pulled toward the pointer on its own spring, so they stretch and
  // trail like liquid; leaving lets them flow back. Runs only while the
  // section is on screen; skipped under reduced motion (CSS glow stays).
  const visual = document.querySelector<HTMLElement>('.why__visual');
  const canvas = visual?.querySelector<HTMLCanvasElement>('[data-liquid]');
  const ctx = canvas?.getContext('2d');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (visual && canvas && ctx && !reduce) {
    const W = canvas.width;
    const GLOW = 700 / 860; // Figma glow diameter relative to the circle
    const REACH = 0.2;      // max blob travel from the centre (canvas units)
    const rgb = getComputedStyle(document.documentElement).getPropertyValue('--brand-accent-rgb').trim().split(/\s+/).join(',');
    const col = (a: number) => `rgba(${rgb},${a})`;

    type Blob = { x: number; y: number; vx: number; vy: number; angle: number; orbit: number; speed: number; k: number; r: number };
    const blobs: Blob[] = [0, 1, 2, 3].map((i) => ({
      x: 0.5, y: 0.5, vx: 0, vy: 0,
      angle: (i / 4) * Math.PI * 2,
      orbit: 0.06 + (i % 2) * 0.04,
      speed: 0.0025 + i * 0.0007,
      k: 0.012 + i * 0.008,          // spring stiffness: different per blob → trailing
      r: 0.3 + (i % 3) * 0.04,
    }));
    const pointer = { x: 0.5, y: 0.5, inside: false };
    let energy = 0; // 0 idle → 1 hovering
    let running = false;
    let raf = 0;

    const draw = () => {
      energy += ((pointer.inside ? 1 : 0) - energy) * 0.05;
      ctx.clearRect(0, 0, W, W);

      // Base glow (Figma: accent 100% → 55% radial, 55% layer opacity).
      const R0 = (W / 2) * GLOW;
      const base = ctx.createRadialGradient(W / 2, W / 2, 0, W / 2, W / 2, R0);
      base.addColorStop(0, col(0.55));
      base.addColorStop(0.85, col(0.3));
      base.addColorStop(1, col(0));
      ctx.fillStyle = base;
      ctx.beginPath(); ctx.arc(W / 2, W / 2, R0, 0, Math.PI * 2); ctx.fill();

      for (const b of blobs) {
        b.angle += b.speed * (1 + energy * 2);
        const homeX = 0.5 + Math.cos(b.angle) * b.orbit;
        const homeY = 0.5 + Math.sin(b.angle * 1.3) * b.orbit;
        // Pull toward the pointer, but keep the blob inside the circle.
        let px = pointer.x - 0.5, py = pointer.y - 0.5;
        const d = Math.hypot(px, py);
        if (d > REACH) { px *= REACH / d; py *= REACH / d; }
        const tx = homeX + (0.5 + px - homeX) * energy * 0.85;
        const ty = homeY + (0.5 + py - homeY) * energy * 0.85;
        b.vx = (b.vx + (tx - b.x) * b.k) * 0.9;
        b.vy = (b.vy + (ty - b.y) * b.k) * 0.9;
        b.x += b.vx; b.y += b.vy;
        // Stretch along the motion for a liquid feel.
        const speed = Math.min(Math.hypot(b.vx, b.vy) * 40, 0.6);
        const ang = Math.atan2(b.vy, b.vx);
        const r = b.r * W * GLOW * (0.7 + energy * 0.35);
        ctx.save();
        ctx.translate(b.x * W, b.y * W);
        ctx.rotate(ang);
        ctx.scale(1 + speed, 1 - speed * 0.4);
        const g = ctx.createRadialGradient(0, 0, 0, 0, 0, r);
        g.addColorStop(0, col(0.22 + energy * 0.3));
        g.addColorStop(1, col(0));
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }
      if (running) raf = requestAnimationFrame(draw);
    };

    const start = () => { if (!running) { running = true; raf = requestAnimationFrame(draw); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { rootMargin: '100px' }).observe(visual);

    visual.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = (e.clientX - r.left) / r.width;
      pointer.y = (e.clientY - r.top) / r.height;
      pointer.inside = true;
    });
    visual.addEventListener('pointerleave', () => { pointer.inside = false; });

    visual.classList.add('is-liquid');
  }
</script>
