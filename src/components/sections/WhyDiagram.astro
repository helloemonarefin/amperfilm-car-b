---
// Why EV-only diagram — DESIGN_SYSTEM §7, Figma 337:188 (1440 × 930).
// Desktop (≥ 1360): three problem points on the left (`h3` + `small` + soft
// tag), each linked by a 1px line to a 10px ink dot on the dotted 860 circle.
// Inside the circle: a blue radial glow and the "Solution" block.
// The circle is anchored to the frame's right edge (as in Figma); the lines
// stretch with the width, so the canvas needs ≥ 1360 to keep every line visible.
// Below 1360 (proposed, §7): the circle becomes a smaller block with the
// Solution inside, and the points stack underneath (3 across from 768).
// Figma's "Car photo circle" layer is an empty (transparent) image: omitted.
import { Image } from 'astro:assets';
import Pill from '../ui/Pill.astro';
import ring from '../../assets/images/home/diagram-ring.png';

export interface WhyProps {
  /** Exactly 3 points (the dots sit at fixed angles on the circle). */
  points: { title: string; text: string; tag: string }[];
  solution: {
    label: string;
    /** `h3-lg`, one entry per line, ≤ 2 lines of ≤ 20 characters. */
    title: string[];
    /** ≤ 120 characters. */
    text: string;
  };
}
const { points, solution } = Astro.props as WhyProps;
---

<section class="why" aria-labelledby="why-title">
  <div class="why__frame frame">
    <div class="why__visual">
      <Image class="why__ring" src={ring} alt="" widths={[860, 1720]} sizes="(min-width: 1360px) 860px, 560px" aria-hidden="true" />
      <span class="glow glow--diagram why__glow" aria-hidden="true"></span>
      <div class="why__solution" data-reveal>
        <p class="t-meta t-medium c-strong">{solution.label}</p>
        <h2 id="why-title" class="t-h3-lg">{solution.title.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
        <p class="t-body-sm c-secondary">{solution.text}</p>
      </div>
    </div>

    <!-- Connector lines + dots (desktop canvas only). They sit at fixed angles
         on the circle; the points beside them are positioned separately. -->
    <div class="why__links" aria-hidden="true">
      {points.map(() => <span class="why__link"></span>)}
    </div>

    <ul class="why__points" role="list">
      {points.map((p) => (
        <li class="why__point" data-reveal>
          <h3 class="t-h3">{p.title}</h3>
          <p class="t-small c-secondary">{p.text}</p>
          <Pill variant="soft">{p.tag}</Pill>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why { overflow: hidden; padding-block: var(--space-18) var(--section-pad-bottom); }
  .why__frame { position: relative; padding-inline: var(--side-pad); }

  /* ---- Stacked layout (< 1360) ---- */
  .why__visual {
    position: relative;
    width: min(100%, 35rem);
    aspect-ratio: 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }
  .why__visual :global(.why__ring) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    /* Slow continuous turn of the dotted ring (owner, 2026-11-17). Stops
       under reduced motion via the global kill switch. */
    animation: spin var(--m-ring-time) linear infinite;
  }
  .why__glow {
    inset: var(--diagram-glow-inset);
    opacity: 0.55;
  }
  .why__solution {
    position: relative;
    display: flex; flex-direction: column; gap: var(--space-3);
    width: 64%;
    text-align: center;
  }
  .why__points {
    display: grid; gap: var(--space-10);
    margin-top: var(--space-14);
  }
  .why__point { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .why__links { display: none; }
  @media (min-width: 768px) {
    .why__points { grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  }

  /* ---- Figma canvas (≥ 1360) ---- */
  @media (min-width: 1360px) {
    .why { padding: 0; }
    .why__frame { height: var(--diagram-h); padding: 0; container-type: inline-size; }
    .why__visual {
      position: absolute; top: var(--diagram-circle-y); right: 0;
      width: var(--diagram-circle); margin: 0; display: block;
    }
    .why__solution {
      position: absolute; left: var(--diagram-solution-x); top: var(--diagram-solution-y);
      width: var(--diagram-solution-w);
      gap: var(--diagram-solution-gap);
      text-align: left;
    }
    /* Points: x 40, tops 156 / 410 / 665 (Figma v2.1). */
    .why__points { position: static; margin: 0; display: block; }
    .why__point { position: absolute; left: var(--diagram-points-x); width: var(--diagram-point-w); }
    .why__point:nth-child(1) { top: var(--diagram-point-y1); }
    .why__point:nth-child(2) { top: var(--diagram-point-y2); }
    .why__point:nth-child(3) { top: var(--diagram-point-y3); }

    /* Lines: start at x 461, end at their dot on the circle. Dot position =
       circle centre + (dx, dy); the circle is anchored to the right edge. */
    .why__links { display: block; }
    .why__link {
      --dx: -350px; --dy: -250px;
      position: absolute;
      top: calc(var(--diagram-circle-y) + var(--diagram-circle) / 2 + var(--dy));
      left: var(--diagram-line-x);
      width: calc(100cqw - var(--diagram-circle) / 2 + var(--dx) - var(--diagram-line-x));
      height: 1px;
      background: var(--border-line);
    }
    .why__link:nth-child(2) { --dx: -430px; --dy: 0px; }
    .why__link:nth-child(3) { --dy: 250px; }
    .why__link::after {
      content: '';
      position: absolute; right: calc(var(--diagram-dot) / -2); top: calc(var(--diagram-dot) / -2 + 0.5px);
      width: var(--diagram-dot); height: var(--diagram-dot);
      border-radius: var(--radius-pill);
      background: var(--text-primary);
    }
  }
</style>
