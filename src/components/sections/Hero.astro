---
// Hero — Figma "Hero v2.2" (388:246), 1440 × 900. Shared by every page.
// Layout (owner, 2026-11-17):
//  - Header row (wordmark 128, not the h1 + menu button) spans the FULL
//    width with side padding, so the menu button lines up with the
//    right-hand menu panel.
//  - Bottom row in the 1360 container: left = glass card + h1 (gap 44);
//    right = service chips + buttons + intro (gap 44), bottom-aligned.
//  - The two rows are pushed apart (space-between).
//  - Height follows the 1440 × 900 ratio (62.5vw) up to 100vh from 1024;
//    the photo fills (cover). Phones keep a full-screen hero.
// Mobile (proposed, §6): wordmark 64, buttons stack full width, chips +
// glass card hidden below 768.
// Motion: wordmark + menu drop in from the top; everything else rises.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Wordmark from '../ui/Wordmark.astro';
import Button from '../ui/Button.astro';
import Pill from '../ui/Pill.astro';
import MenuButton from '../layout/MenuButton.astro';

export interface HeroProps {
  image: ImageMetadata;
  imageAlt?: string;
  /** Headline lines (`h1`). Limit: 2 lines, ≤ 30 characters each (DESIGN_SYSTEM §9). */
  headline: string[];
  /** Service chips on the right; one may be `active` (glass). ≤ 3, ≤ 22 characters. */
  chips?: { label: string; active?: boolean }[];
  /** Small glass card above the headline. Text ≤ 28 characters. */
  card?: { image: ImageMetadata; imageAlt?: string; tag: string; text: string };
  /** Two buttons: ghost-white then white. Labels ≤ 28 characters. */
  actions: { label: string; href: string; variant: 'ghost-white' | 'white' }[];
  /** Right-aligned intro, ≤ 160 characters (3 lines at 430px). */
  intro?: string;
  /** CSS object-position for the photo crop (e.g. "70% center" on phones). */
  imagePosition?: string;
  /** Dark top/bottom gradient over the photo (v2.1). Home v2.2 has none. */
  overlay?: boolean;
  /** WebP quality. 80 keeps the mobile hero light (Lighthouse ≥ 95); raise it
      only for photos with smooth gradients that band (Home uses 90). */
  quality?: number;
}

const { image, imageAlt = '', imagePosition = 'center', overlay = true, quality = 80, headline, chips = [], card, actions, intro } = Astro.props as HeroProps;

// Page-load order (owner, 2026-11-17): top-left → top-right → bottom-left
// (card, then each headline line) → bottom-right (each chip, each button,
// then the paragraph). Every element gets its own step (--m-intro-stagger).
// The header row drops in from the top (data-intro="down").
let step = 0;
const intro_ = (dir = '') => ({ 'data-intro': dir, style: `--i:${step++}` });
const iWordmark = intro_('down');
const iMenu = intro_('down');
const iCard = card ? intro_() : undefined;
// The card's tag and text follow the card itself, one step each.
const iCardTag = card ? intro_() : undefined;
const iCardText = card ? intro_() : undefined;
const iLines = headline.map(() => intro_());
const iChips = chips.map(() => intro_());
const iButtons = actions.map(() => intro_());
const iIntro = intro ? intro_() : undefined;

// Responsive widths up to the source size (a sharper upload gets more widths).
const widths = [640, 960, 1280, 1600, 1920, 2560].filter((w) => w < image.width).concat(image.width);
---

<header class:list={['hero', { 'hero--overlay': overlay }]}>
  <div class="hero__bg" aria-hidden={imageAlt ? undefined : 'true'}>
    <Image
      class="hero__img"
      src={image}
      alt={imageAlt}
      widths={widths}
      sizes="100vw"
      quality={quality}
      style={`object-position: ${imagePosition}`}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__decor" aria-hidden="true">
    <span class="glow hero__glow"></span>
    <!-- Line + ring groups, aligned to the Proof strip's outer rail lines.
         The right group mirrors the left one (owner, 2026-11-17). -->
    <span class="hero__group hero__group--l"><span class="hero__ring"></span><span class="hero__line"></span></span>
    <span class="hero__group hero__group--r"><span class="hero__ring"></span><span class="hero__line"></span></span>
  </div>

  <div class="hero__inner">
    <div class="hero__top">
      <Wordmark size="hero" href="/" class="hero__wm" {...iWordmark} />
      <MenuButton class="hero__menu" {...iMenu} />
    </div>

    <div class="hero__bottom frame">
      <div class="hero__cols">
      <div class="hero__left">
        {card && (
          <div class="hero__card glass glass--sm" {...iCard}>
            <Image class="hero__thumb" src={card.image} alt={card.imageAlt ?? ''} widths={[52, 104]} sizes="52px" />
            <div class="hero__card-text">
              <Pill variant="accent" class="hero__trim" {...iCardTag}>{card.tag}</Pill>
              <p class="t-meta lh-snug hero__card-copy hero__trim" {...iCardText}>{card.text}</p>
            </div>
          </div>
        )}
        <h1 class="t-hero hero__title">
          {headline.map((line, i) => <>{i > 0 && ' '}<span class="hero__hline" {...iLines[i]}>{line}</span></>)}
        </h1>
      </div>

      <div class="hero__right">
        {chips.length > 0 && (
          <ul class="hero__chips" role="list">
            {chips.map((c, i) => <li {...iChips[i]}><Pill variant={c.active ? 'glass' : 'plain'}>{c.label}</Pill></li>)}
          </ul>
        )}
        <div class="hero__actions">
          <div class="hero__buttons">
            {actions.map((a, i) => <Button variant={a.variant} label={a.label} href={a.href} {...iButtons[i]} />)}
          </div>
          {intro && <p class="t-small hero__intro" {...iIntro}>{intro}</p>}
        </div>
      </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: max(100svh, 40rem);
    color: var(--text-on-dark);
    background: var(--bg-inverse);
  }
  /* Entrance (owner, 2026-11-17): everything in the hero settles from 1.1 to
     1. The layers (photo, decor, content) all share the hero's box, so they
     scale around the same centre, and the hero's overflow clips them — the
     hero itself keeps its size and never covers the next section. */
  .hero > * { animation: settle-in var(--m-hero-scale-time) var(--m-hero-scale-ease) both; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg :global(.hero__img) { width: 100%; height: 100%; object-fit: cover; }
  .hero--overlay .hero__bg::after { content: ''; position: absolute; inset: 0; background: var(--overlay-hero); }

  .hero__decor { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__glow { width: var(--hero-glow-w); height: var(--hero-glow-h); left: var(--hero-glow-x); top: var(--hero-glow-y); }
  .hero__ring, .hero__line { display: none; }

  /* Header row and bottom row pushed apart. */
  .hero__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-10);
    padding: var(--hero-pad-top) 0 var(--hero-pad-bottom);
  }

  /* Header: FULL width, only side padding (owner). */
  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding-inline: var(--side-pad);
  }
  /* Phones: wordmark 40% smaller (owner, 2026-11-17). */
  .hero__top :global(.hero__wm) { font-size: calc(var(--fs-wordmark) * var(--wordmark-scale-m)); }
  /* Phones: 3px higher and 5% smaller than the token size, so it reads level
     with the smaller wordmark (owner, 2026-11-17). */
  .hero__top :global(.hero__menu) {
    margin-top: var(--hero-menu-offset-m);
    --menu-btn-w: calc(var(--menu-btn-w-m) * var(--hero-menu-scale-m));
    --menu-btn-h: calc(var(--menu-btn-h-m) * var(--hero-menu-scale-m));
    --menu-btn-bar: calc(var(--menu-btn-bar-m) * var(--hero-menu-scale-m));
  }

  /* Bottom row: same frame as the rails; content inset to the rail text
     (x 80 / 1360 at 1440) from 1024 (owner, 2026-11-17). */
  .hero__bottom { padding-inline: var(--side-pad); container-type: inline-size; }
  .hero__cols { display: flex; flex-direction: column; gap: var(--space-8); }
  .hero__left { display: flex; flex-direction: column; align-items: flex-start; gap: var(--hero-col-gap); }
  .hero__right { display: flex; flex-direction: column; align-items: flex-start; gap: var(--hero-col-gap); }

  .hero__card { display: none; }
  .hero__chips { display: none; }
  .hero__title { color: var(--text-on-dark); }
  /* One block per Figma line (each animates on its own); each line wraps
     balanced on phones so no line is left with a single word. */
  .hero__hline { display: block; text-wrap-style: balance; }
  /* Figma trims the headline and card text to cap height / baseline. */
  .hero__title, .hero__bottom :global(.hero__trim) { text-box: trim-both cap alphabetic; }

  .hero__actions { display: flex; flex-direction: column; gap: var(--space-5); }
  .hero__buttons { display: flex; flex-direction: column; gap: var(--gap-tight); width: 100%; }
  .hero__buttons :global(.btn) { width: 100%; }
  .hero__intro { color: var(--text-on-dark-strong); max-width: var(--hero-actions-w); }

  /* ≥ 768: glass card and chips; buttons side by side. */
  @media (min-width: 768px) {
    .hero__top :global(.hero__wm) { font-size: var(--fs-wordmark); }
    .hero__top :global(.hero__menu) { --menu-btn-w: var(--menu-btn-w-d); --menu-btn-h: var(--menu-btn-h-d); --menu-btn-bar: var(--menu-btn-bar-d); margin-top: var(--hero-menu-offset); }
    .hero__card {
      display: flex; align-items: center; gap: var(--gap-tight);
      width: max-content;
      /* Figma strokes sit inside the box: padding minus the 1px border. */
      padding: calc(var(--space-2) - 1px) calc(var(--space-3) - 1px) calc(var(--space-2) - 1px) calc(var(--space-2) - 1px);
    }
    .hero__card :global(.hero__thumb) { width: var(--hero-thumb); height: var(--hero-thumb); object-fit: cover; border-radius: var(--radius-sm); }
    .hero__card-text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .hero__card-copy { color: var(--text-on-dark-strong); }
    .hero__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .hero__chips li { display: flex; }
    .hero__buttons { flex-direction: row; width: auto; }
    .hero__buttons :global(.btn) { width: auto; }
  }

  /* ≥ 1024: height follows the 1440 × 900 ratio, capped at the screen height
     (owner); the content always fits (min-content). Decor ring + line. */
  @media (min-width: 1024px) {
    .hero {
      height: min(calc(100vw * var(--hero-ratio)), 100svh);
      min-height: min-content;
    }
    /* x of the Proof strip's left rail line: the 1440 frame's left edge
       (centred above 1440) + the side gutter. */
    .hero__bottom { padding-inline: calc(var(--side-pad) * 2); }
    .hero__group { position: absolute; top: 0; bottom: 0; width: 1px; }
    /* Left: on the left rail line (the gutter's border-right = its last pixel). */
    .hero__group--l { left: calc(max(0px, (100% - var(--content-max) - 2 * var(--side-pad)) / 2) + var(--side-pad) - 1px); }
    /* Right: on the right rail line (the right gutter's border-left = its first pixel). */
    .hero__group--r { right: calc(max(0px, (100% - var(--content-max) - 2 * var(--side-pad)) / 2) + var(--side-pad) - 1px); }
    .hero__ring {
      display: block; position: absolute; top: var(--hero-ring-y);
      width: var(--hero-ring); height: var(--hero-ring);
      border: 1px solid var(--hero-ring-line); border-radius: var(--radius-pill);
    }
    /* Each ring keeps the Figma offset from its line and bulges toward the centre. */
    .hero__group--l .hero__ring { left: var(--hero-ring-dx); }
    .hero__group--r .hero__ring { right: var(--hero-ring-dx); }
    .hero__line { display: block; position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: var(--hero-line-color); }
  }

  /* Side by side (Figma) only when both columns fit with at least the
     minimum gap: 703 (left) + 486 (right) + 64 = 1253px of content.
     Narrower: the columns stack, so they never collide (owner). */
  @container (min-width: 1253px) {
    .hero__cols { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: var(--hero-col-min-gap); }
    .hero__left { width: var(--hero-left-w); }
    .hero__title { white-space: nowrap; }
    .hero__right { width: var(--hero-right-w); align-items: flex-end; }
    .hero__chips { flex-direction: column; align-items: flex-end; }
    .hero__actions { align-items: flex-end; }
    .hero__intro { width: var(--hero-actions-w); text-align: right; }
  }
</style>
