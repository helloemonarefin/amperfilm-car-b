---
// How it works — DESIGN_SYSTEM §7 "Steps", Figma 337:713.
// Centred icon badge + h2 + body-lg, then rails: left 500 (p40) with a
// progress photo card (r16, accent tint 18%, title, 3 glass status rows with
// Done / In progress pills) + caption; right: 4 step rows (44 / 64 padding,
// gap 56): round icon (the first filled accent, the rest outline) + meta
// number + h5 + body-sm.
// Mobile: photo card on top (max 420), then the steps.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import IconBadge from '../ui/IconBadge.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import Pill from '../ui/Pill.astro';

export interface StepsProps {
  icon: IconName;
  /** `h2`, one line at desktop (≤ 30 characters). */
  title: string;
  /** `body-lg`, ≤ 90 characters. */
  intro: string;
  photo: {
    image: ImageMetadata;
    alt: string;
    /** ≤ 24 characters. */
    title: string;
    /** Exactly 3 rows; `done` → accent "Done" pill, otherwise white "In progress". */
    rows: { title: string; text: string; done: boolean }[];
    doneLabel: string;
    progressLabel: string;
    caption: string;
  };
  /** Exactly 4. Title ≤ 18, text ≤ 90 characters. */
  steps: { icon: IconName; title: string; text: string }[];
}
const { icon, title, intro, photo, steps } = Astro.props as StepsProps;
---

<section class="steps" id="how-it-works" aria-labelledby="steps-title">
  <div class="container steps__head">
    <span data-reveal><IconBadge icon={icon} /></span>
    <h2 id="steps-title" class="t-h2" data-reveal>{title}</h2>
    <p class="t-body-lg c-tertiary" data-reveal>{intro}</p>
  </div>

  <div class="steps__body frame">
    <div class="steps__side">
      <div class="steps__photo" data-reveal>
        <Image class="steps__img" src={photo.image} alt={photo.alt} widths={[420, 840]} sizes="(min-width: 768px) 420px, 100vw" />
        <p class="t-h3 lh-tighter steps__photo-title" data-reveal>{photo.title}</p>
        <ul class="steps__status" role="list">
          {photo.rows.map((r) => (
            <li class="steps__row" data-reveal>
              <span class="steps__row-text">
                <span class="t-name steps__row-title" data-reveal>{r.title}</span>
                <span class="t-micro steps__row-sub" data-reveal>{r.text}</span>
              </span>
              <Pill variant={r.done ? 'accent-tag' : 'white-tag'} data-reveal>{r.done ? photo.doneLabel : photo.progressLabel}</Pill>
            </li>
          ))}
        </ul>
      </div>
      <p class="t-small c-tertiary steps__caption" data-reveal>{photo.caption}</p>
    </div>

    <ol class="steps__list" role="list">
      {steps.map((s, i) => (
        <li class="steps__step">
          <span class:list={['steps__icon', { 'is-first': i === 0 }]} aria-hidden="true" data-reveal><Icon name={s.icon} size={18} /></span>
          <span class="steps__step-text">
            <span class="steps__step-head">
              <span class="t-meta t-medium c-tertiary" data-reveal>{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h5" data-reveal>{s.title}</h3>
            </span>
            <span class="t-body-sm c-secondary steps__step-body" data-reveal>{s.text}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { border-top: 1px solid var(--border-rail); }
  .steps__head { display: flex; flex-direction: column; align-items: center; gap: var(--space-6); padding-block: var(--space-18) var(--space-14); text-align: center; }

  .steps__body { display: grid; border-top: 1px solid var(--border-rail); }
  .steps__side { display: flex; flex-direction: column; align-items: center; gap: var(--space-5); padding: var(--space-10) var(--side-pad); }
  .steps__photo {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between;
    width: min(100%, var(--steps-photo-w)); height: var(--steps-photo-h);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    color: var(--text-on-dark);
  }
  .steps__photo :global(.steps__img) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .steps__photo::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--tint-steps); }
  .steps__status { display: flex; flex-direction: column; gap: var(--space-2); }
  .steps__row {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--menu-card-gap);
    border: 1px solid var(--border-glass); border-radius: var(--radius-md);
    background: var(--glass-lg-bg);
    -webkit-backdrop-filter: blur(calc(var(--glass-md-blur) / 2));
    backdrop-filter: blur(calc(var(--glass-md-blur) / 2));
  }
  .steps__row-text { display: flex; flex-direction: column; gap: var(--gap-hair); flex: 1; min-width: 0; }
  .steps__row-title { font-size: var(--fs-body); }
  .steps__row-sub { color: var(--text-on-dark-strong); }
  .steps__caption { line-height: var(--lh-small); text-align: center; }

  .steps__list { display: flex; flex-direction: column; }
  .steps__step { display: flex; gap: var(--space-6); padding: var(--space-8) var(--side-pad); border-top: 1px solid var(--border-rail); }
  .steps__icon {
    display: grid; place-items: center; flex: none;
    width: var(--round-lg); height: var(--round-lg);
    border: 1px solid var(--border-default); border-radius: var(--radius-pill);
    color: var(--text-primary);
  }
  .steps__icon.is-first { background: var(--bg-accent); border-color: var(--bg-accent); color: var(--text-on-accent); }
  .steps__step-text { display: flex; flex-direction: column; gap: var(--gap-tight); min-width: 0; }
  .steps__step-head { display: flex; align-items: center; gap: var(--space-3); }
  .steps__step-body { max-width: var(--steps-text-w); }

  @media (min-width: 1024px) {
    .steps__head { padding: var(--steps-head-pad); }
    .steps__body { grid-template-columns: var(--steps-side-w) minmax(0, 1fr); }
    .steps__side { padding: var(--space-10); border-right: 1px solid var(--border-rail); }
    .steps__step { gap: var(--steps-row-gap); padding: var(--steps-row-pad); border-top: 0; }
    .steps__step + .steps__step { border-top: 1px solid var(--border-rail); }
    .steps__step:not(:last-child) { border-bottom: 0; }
  }
</style>
