---
// Price picker — DESIGN_SYSTEM §7, Figma 337:216 / 338:121.
// Left: white card "1. Pick your EV" with model rows (real radios; the
// selected row is an accent pill with a white check circle; "Other EVs" last
// in a softer tone) + a note. Right: photo of the selected model (r4,
// horizontal gradient, panel glow) + "MODEL · MOST BOOKED" pill + glass-lg
// price panel ("2. Pick a package" radios, price-xl + "all in", description,
// white CTA) + "See the full price list" link.
// Everything reads from pricing.ts. Without JS the default model + package
// show; the swap script is added in Phase 5 (data-picker hooks are in place).
// Mobile (§6): models become a horizontal pill row; the panel sits below the photo.
import { Image } from 'astro:assets';
import SectionMeta from '../ui/SectionMeta.astro';
import SectionHeader, { type TwoTone } from '../ui/SectionHeader.astro';
import Pill from '../ui/Pill.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import ArrowSwap from '../ui/ArrowSwap.astro';
import { pricing, model, modelLabel, pkg, price } from '../../content/pricing';

export interface PickerProps {
  index?: number;
  label: string;
  title: TwoTone;
  intro: string;
  /** "1. Pick your EV" */
  modelsLabel: string;
  /** "2. Pick a package" */
  packagesLabel: string;
  /** "all in" */
  unit: string;
  /** Suffix on the photo pill for the most-booked model ("Most booked"). */
  mostBooked: string;
  cta: { label: string; href: string };
  more: { label: string; href: string };
}
const p = Astro.props as PickerProps;

const current = model(pricing.defaults.model);
const currentPkg = pkg(pricing.defaults.package);
const pickerPkgs = pricing.packages.filter((x) => x.inPicker);
const photo = current.image ?? pricing.models.find((m) => m.image)?.image;
const pillText = `${modelLabel(current)}${current.mostBooked ? ` · ${p.mostBooked}` : ''}`;
---

<section class="section picker-section" id="pricing" aria-labelledby="pricing-title">
  <SectionMeta index={p.index} label={p.label} />
  <div class="container">
    <SectionHeader id="pricing-title" title={p.title} intro={p.intro} introMax="md" pb="lg" />
  </div>

  <div class="container">
    <div class="picker" data-picker>
      <!-- 1. Models -->
      <div class="picker__list" data-reveal>
        <p class="t-meta t-medium c-tertiary" id="picker-models" data-reveal>{p.modelsLabel}</p>
        <div class="picker__models" role="radiogroup" aria-labelledby="picker-models">
          {pricing.models.map((m) => (
            <label class="picker__row" data-reveal>
              <input class="sr-only" type="radio" name="model" value={m.id} checked={m.id === current.id} />
              <span class="t-title picker__name">{modelLabel(m)}</span>
              <span class="picker__round" aria-hidden="true">
                <Icon name="arrow-up-right" size={14} class="picker__arrow" />
                <Icon name="check" size={14} class="picker__check" />
              </span>
            </label>
          ))}
          <label class="picker__row picker__row--other" data-reveal>
            <input class="sr-only" type="radio" name="model" value="other" />
            <span class="t-title picker__name">{pricing.other.label}</span>
            <span class="picker__round" aria-hidden="true">
              <Icon name="arrow-up-right" size={14} class="picker__arrow" />
              <Icon name="check" size={14} class="picker__check" />
            </span>
          </label>
        </div>
        <p class="t-small c-tertiary picker__note" data-reveal>{pricing.other.note}</p>
      </div>

      <!-- 2. Photo + glass price panel -->
      <div class="picker__visual" data-reveal>
        <div class="picker__photo">
          {photo && <Image class="picker__img" src={photo} alt="" widths={[640, 948, 1400, 1896]} sizes="(min-width: 1440px) 948px, (min-width: 1024px) 66vw, 100vw" data-picker-img />}
          <span class="glow glow--panel picker__glow" aria-hidden="true"></span>
          <Pill variant="white" class="picker__pill" data-picker-pill data-reveal>{pillText}</Pill>
        </div>

        <div class="picker__panel glass glass--lg" data-reveal>
          <p class="t-meta t-medium picker__panel-label" id="picker-packages" data-reveal>{p.packagesLabel}</p>
          <div class="picker__pkgs" role="radiogroup" aria-labelledby="picker-packages">
            {pickerPkgs.map((x) => (
              <label class="picker__pkg t-tag" data-reveal>
                <input class="sr-only" type="radio" name="package" value={x.id} checked={x.id === currentPkg.id} />
                {x.short}
              </label>
            ))}
          </div>
          <p class="picker__price" aria-live="polite" data-reveal>
            <span class="t-price-xl" data-picker-price>{price(current.id, currentPkg.id)}</span>
            <span class="t-body picker__unit">{p.unit}</span>
          </p>
          <p class="t-small picker__desc" data-picker-desc data-reveal>{currentPkg.pickerText ?? currentPkg.description}</p>
          <Button variant="white" block spread class="picker__cta" label={p.cta.label} href={p.cta.href} data-picker-cta data-reveal />
        </div>

        <a data-reveal class="picker__more t-link arrow-trigger" href={p.more.href}>{p.more.label}<ArrowSwap icon="arrow-up-right" size={16} dir="diag" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .picker { display: grid; gap: var(--grid-gutter); }

  /* ---- Model list ---- */
  .picker__list { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .picker__models { display: flex; gap: var(--space-2); overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--side-pad) * -1); padding-inline: var(--side-pad); }
  .picker__models::-webkit-scrollbar { display: none; }
  .picker__row {
    position: relative;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    flex: none;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    color: var(--text-strong);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--m-hover-time) var(--m-hover-ease), color var(--m-hover-time) var(--m-hover-ease);
  }
  .picker__row--other { color: var(--text-tertiary); }
  .picker__row:has(input:checked) { background: var(--bg-accent); border-color: var(--bg-accent); color: var(--text-on-accent); }
  .picker__row:has(input:focus-visible), .picker__pkg:has(input:focus-visible) { outline: var(--focus-width) solid var(--focus-color); outline-offset: var(--focus-offset); }
  .picker__round { display: none; }
  .picker__note { order: 3; }

  /* ---- Photo + panel ---- */
  .picker__visual { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: var(--radius-media); background: var(--bg-inverse); color: var(--text-on-dark); }
  .picker__photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .picker__photo :global(.picker__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .picker__photo::after { content: ''; position: absolute; inset: 0; background: var(--overlay-picker); }
  .picker__glow { display: none; }
  .picker__photo :global(.picker__pill) { position: absolute; z-index: 1; top: var(--picker-inset); left: var(--picker-inset); }

  .picker__panel {
    position: relative;
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4);
    margin: var(--space-3);
    padding: var(--space-6);
  }
  .picker__panel-label { color: var(--text-on-dark-strong); }
  .picker__pkgs { display: flex; flex-wrap: wrap; gap: var(--picker-pill-gap); }
  .picker__pkg {
    position: relative;
    padding: var(--pill-py-lg) var(--pill-px-lg);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-pill);
    color: var(--text-on-dark);
    cursor: pointer;
    transition: background-color var(--m-hover-time) var(--m-hover-ease), color var(--m-hover-time) var(--m-hover-ease);
  }
  .picker__pkg:has(input:checked) { background: var(--bg-card); border-color: var(--bg-card); color: var(--text-primary); }
  @media (hover: hover) and (pointer: fine) {
    .picker__row:not(:has(input:checked)):hover { border-color: var(--text-primary); }
    .picker__pkg:not(:has(input:checked)):hover { background: var(--glass-md-bg); }
  }
  .picker__price { display: flex; align-items: baseline; gap: var(--gap-tight); white-space: nowrap; }
  .picker__unit { color: var(--text-on-dark-secondary); }
  .picker__desc { color: var(--text-on-dark-strong); }
  .picker__more { display: inline-flex; align-items: center; gap: var(--space-2); align-self: flex-start; min-height: var(--tap-min); margin: 0 var(--space-6) var(--space-6); color: var(--text-on-dark); }

  /* ---- Desktop (Figma) ---- */
  @media (min-width: 1024px) {
    .picker { grid-template-columns: var(--picker-list-w) minmax(0, 1fr); }

    .picker__list { gap: 0; padding: var(--picker-pad); border-radius: var(--radius-media); background: var(--bg-card); }
    .picker__list > p:first-child { margin-bottom: var(--space-4); }
    .picker__models { flex-direction: column; gap: 0; overflow: visible; margin: 0; padding: 0; }
    .picker__row {
      padding: var(--picker-row-py) 0;
      border: 0;
      border-bottom: 1px solid var(--border-rail);
      border-radius: 0;
      gap: 0; /* Figma: text and circle touch on the longest row */
    }
    .picker__row:has(input:checked) {
      padding: var(--picker-row-py) var(--picker-row-pr) var(--picker-row-py) var(--picker-row-pl);
      border-radius: var(--radius-pill);
      border-bottom-color: transparent;
    }
    .picker__round {
      display: grid; place-items: center; flex: none;
      width: var(--picker-round); height: var(--picker-round);
      border: 1px solid var(--border-default);
      border-radius: var(--radius-pill);
      color: var(--text-primary);
    }
    .picker__round :global(.picker__check) { display: none; }
    .picker__row:has(input:checked) .picker__round { background: var(--bg-card); border-color: var(--bg-card); color: var(--brand-accent); }
    .picker__row:has(input:checked) .picker__round :global(.picker__arrow) { display: none; }
    .picker__row:has(input:checked) .picker__round :global(.picker__check) { display: block; }
    .picker__note { margin-top: auto; padding-top: var(--space-8); }

    .picker__visual { display: block; height: var(--picker-h); background: transparent; }
    .picker__photo { position: absolute; inset: 0; aspect-ratio: auto; }
    .picker__glow {
      display: block;
      width: var(--picker-glow-w); height: var(--picker-glow-h);
      right: var(--picker-glow-r);
      top: var(--picker-glow-y);
    }
    .picker__panel {
      position: absolute; top: var(--picker-glass-y); right: var(--picker-glass-r);
      width: var(--picker-glass-w);
      margin: 0;
    }
    .picker__more { position: absolute; left: var(--picker-inset); bottom: var(--picker-inset); margin: 0; }
  }
</style>
