---
// Renders a page's section array in order, passing each entry's props and
// its generated (0n) index (lib/sections.ts). Adding a section type means
// adding one line to the map below.
import ProofStrip from '../sections/ProofStrip.astro';
import Statement from '../sections/Statement.astro';
import WhyDiagram from '../sections/WhyDiagram.astro';
import Installs from '../sections/Installs.astro';
import PricePicker from '../sections/PricePicker.astro';
import Offer from '../sections/Offer.astro';
import Split from '../sections/Split.astro';
import Services from '../sections/Services.astro';
import Models from '../sections/Models.astro';
import Steps from '../sections/Steps.astro';
import { numberSections, type SectionEntry } from '../../lib/sections';

interface Props { sections: SectionEntry[] }

const map: Record<string, any> = {
  proof: ProofStrip,
  statement: Statement,
  why: WhyDiagram,
  installs: Installs,
  picker: PricePicker,
  offer: Offer,
  split: Split,
  services: Services,
  models: Models,
  steps: Steps,
};

const entries = numberSections(Astro.props.sections);
---

{entries.map((e) => {
  const C = map[e.kind];
  if (!C) throw new Error(`SectionRenderer: no component for "${e.kind}"`);
  return <C {...e.props} index={e.index} />;
})}
