---
// Menu button — DESIGN_SYSTEM §7: 68 × 36, three 3.83px lines, in
// currentColor (white on the hero). Opens the menu panel (MenuPanel.astro).
// Every instance (hero, sticky bar) shares data-menu-toggle; the panel
// script keeps aria-expanded in sync on all of them.
interface Props { size?: 'md' | 'sm'; class?: string; [key: string]: unknown }
const { size = 'md', class: className, ...rest } = Astro.props;
---

<button
  class:list={['menu-btn', `menu-btn--${size}`, className]}
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="site-menu"
  data-menu-toggle
  {...rest}
>
  <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
</button>

<style>
  .menu-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: none;
    width: var(--menu-btn-w);
    /* Tap target ≥ 24px even when drawn smaller (phone hero button is 22.8):
       the extra height is padding with an equal negative margin, so the
       bars and the layout stay exactly where they were. */
    --tap-extra: max(0px, (var(--tap-min) - var(--menu-btn-h)) / 2);
    height: calc(var(--menu-btn-h) + 2 * var(--tap-extra));
    padding-block: var(--tap-extra);
    margin-block: calc(var(--tap-extra) * -1);
    box-sizing: border-box;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-btn span {
    display: block;
    height: var(--menu-btn-bar);
    background: currentColor;
    transform-origin: center;
    transition:
      translate var(--m-burger-time) var(--m-burger-ease),
      rotate var(--m-burger-time) var(--m-burger-ease),
      scale var(--m-burger-time) var(--m-burger-ease),
      opacity var(--m-burger-time) var(--m-burger-ease);
  }
  /* Open: the middle bar collapses, top and bottom meet in the middle and
     rotate ±45° into a cross (owner, 2026-11-17). */
  .menu-btn[aria-expanded='true'] span:nth-child(1) { translate: 0 calc((var(--menu-btn-h) - var(--menu-btn-bar)) / 2); rotate: 45deg; }
  .menu-btn[aria-expanded='true'] span:nth-child(2) { scale: 0 1; opacity: 0; }
  .menu-btn[aria-expanded='true'] span:nth-child(3) { translate: 0 calc((var(--menu-btn-h) - var(--menu-btn-bar)) / -2); rotate: -45deg; }
  /* Compact sticky bar: half size, same proportions. */
  .menu-btn--sm { width: calc(var(--menu-btn-w) / 2); height: calc(var(--menu-btn-h) / 2); }
  .menu-btn--sm span { height: calc(var(--menu-btn-bar) / 2); }
  /* Keep the tap target ≥ 24px even when drawn small. */
  .menu-btn--sm::after { content: ''; position: absolute; inset: calc(var(--space-2) * -1); }
</style>
