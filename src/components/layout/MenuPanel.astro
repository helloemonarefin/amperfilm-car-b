---
// Menu panel — DESIGN_SYSTEM §7 (Figma 373:121), BOILERPLATE §1.8 behaviour.
// A floating glass panel from the right (520 wide, 16 from the edges, r24,
// glass-menu) over a backdrop that dims and blurs the page.
// The menu button never moves (owner, 2026-11-17): on open, a copy of the
// clicked hamburger is placed exactly over it, morphs into a cross and acts
// as the close button, while the panel's background grows out of it (a
// circular clip-path reveal from the button's centre). Closing reverses it.
// Contents: "Menu" label; 8 numbered links (current page = "You're
// here" pill + aria-current); featured offer card; CTA; two contact columns.
// Behaviour: focus trap, Esc, backdrop click, scroll lock, aria-expanded on
// every [data-menu-toggle]. Without JS the menu stays closed; the footer
// carries the same links.
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import ArrowSwap from '../ui/ArrowSwap.astro';
import Pill from '../ui/Pill.astro';
import RoundButton from '../ui/RoundButton.astro';
import Button from '../ui/Button.astro';
import { site, telHref } from '../../content/site';
import { model, price } from '../../content/pricing';

interface Props {
  /** Override the current path (styleguide demo of the "You're here" state). */
  currentPath?: string;
}
const here = ((Astro.props.currentPath ?? Astro.url.pathname).replace(/\/$/, '') || '/');
const isCurrent = (href?: string) => href != null && (href.replace(/\/$/, '') || '/') === here;
const offer = site.menu.offer;
const offerPrice = price(offer.model, offer.package);
---

<div class="menu" id="site-menu" data-menu inert>
  <div class="menu__backdrop" data-menu-close aria-hidden="true"></div>
  <!-- The hamburger's stand-in: sits over the clicked button, morphs into the cross. -->
  <button class="menu__toggle" type="button" aria-label="Close menu" data-menu-close data-menu-ghost>
    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>
  <div class="menu__panel glass glass--menu" role="dialog" aria-modal="true" aria-labelledby="menu-title" data-lenis-prevent>
    <div class="menu__head">
      <p class="menu__title t-eyebrow" id="menu-title"><span class="menu__dot" aria-hidden="true"></span>{site.menu.title}</p>
    </div>

    <nav class="menu__nav" aria-label="Main">
      <ol role="list">
        {site.nav.map((link, i) => (
          <li class="menu__item" style={`--i:${i}`}>
            <a class="menu__link arrow-trigger" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              <span class="menu__label">
                <span class="menu__index t-micro t-medium" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="t-h3 lh-tighter menu__text">{link.label}</span>
              </span>
              {isCurrent(link.href)
                ? <Pill variant="accent" wide>{site.menu.here}</Pill>
                : <ArrowSwap icon="arrow-up-right" dir="diag" />}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="menu__spacer"></div>

    <a class="menu__offer menu__item arrow-trigger" href={offer.href} style={`--i:${site.nav.length}`}>
      <Image class="menu__thumb" src={offer.image} alt={offer.imageAlt} widths={[64, 128]} sizes="64px" />
      <span class="menu__offer-text">
        <span class="t-name menu__offer-title">{offer.title}</span>
        <span class="t-micro menu__offer-sub">{model(offer.model).name} {offerPrice} · {offer.note}</span>
      </span>
      <RoundButton as="span" size="lg" variant="white"><ArrowSwap icon="arrow-right" /></RoundButton>
    </a>

    <div class="menu__item menu__cta" style={`--i:${site.nav.length + 1}`}>
      <Button variant="cta" block label={site.menu.cta.label} href={site.menu.cta.href} />
    </div>

    <div class="menu__contact menu__item" style={`--i:${site.nav.length + 2}`}>
      <div class="menu__col">
        <p class="menu__col-label t-micro t-medium"><Icon name="phone" />{site.menu.contactLabel}</p>
        <p class="t-meta lh-snug menu__col-text">
          <a href={telHref}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <div class="menu__col">
        <p class="menu__col-label t-micro t-medium"><Icon name="pin" />{site.menu.studioLabel}</p>
        <p class="t-meta lh-snug menu__col-text">{site.address.street}<br />{site.hours}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .menu { position: fixed; inset: 0; z-index: var(--z-menu); visibility: hidden; transition: visibility 0s linear var(--menu-close); --menu-close: calc(var(--m-menu-reveal-time) * 0.6); }
  .menu.is-open { visibility: visible; transition: visibility 0s; }
  /* The clicked hamburger hides while its stand-in is on screen. !important
     beats the finished intro animation's opacity. */
  :global(.is-menu-source) { opacity: 0 !important; }

  .menu__backdrop {
    position: absolute; inset: 0;
    background: var(--bg-backdrop);
    -webkit-backdrop-filter: blur(calc(var(--backdrop-blur) / 2));
    backdrop-filter: blur(calc(var(--backdrop-blur) / 2));
    opacity: 0;
    transition: opacity var(--menu-close) var(--ease-in);
  }
  .is-open .menu__backdrop { opacity: 1; transition: opacity var(--m-menu-time) var(--m-menu-ease); }

  .menu__panel {
    position: absolute;
    top: var(--menu-inset); right: var(--menu-inset); bottom: var(--menu-inset);
    width: min(var(--menu-w), calc(100% - 2 * var(--menu-inset)));
    display: flex; flex-direction: column;
    padding: var(--menu-pad);
    padding-bottom: calc(var(--space-7) + env(safe-area-inset-bottom));
    border-color: var(--border-glass);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Background grows out of the menu button (--cx/--cy/--cr set by JS). */
    clip-path: circle(0px at var(--cx, 100%) var(--cy, 0%));
    transition: clip-path var(--menu-close) var(--ease-in);
  }
  .is-open .menu__panel {
    clip-path: circle(var(--cr, 150%) at var(--cx, 100%) var(--cy, 0%));
    transition: clip-path var(--m-menu-reveal-time) var(--m-menu-ease);
  }

  /* Stand-in hamburger → cross. Position, size and bar thickness are copied
     from the clicked button (--tx/--ty/--tw/--th/--tb, --tc = its colour). */
  .menu__toggle {
    position: fixed; z-index: 2;
    left: var(--tx); top: var(--ty); width: var(--tw); height: var(--th);
    display: flex; flex-direction: column; justify-content: space-between;
    color: var(--tc, var(--text-on-dark));
    transition: color var(--m-burger-time) var(--m-burger-ease);
  }
  .menu__toggle span {
    display: block; height: var(--tb); background: currentColor; transform-origin: center;
    transition:
      translate var(--m-burger-time) var(--m-burger-ease),
      rotate var(--m-burger-time) var(--m-burger-ease),
      scale var(--m-burger-time) var(--m-burger-ease),
      opacity var(--m-burger-time) var(--m-burger-ease);
  }
  .menu__toggle::after { content: ''; position: absolute; inset: calc(var(--space-2) * -1); } /* ≥ 24px tap target */
  .is-morph .menu__toggle { color: var(--text-on-dark); }
  .is-morph .menu__toggle span:nth-child(1) { translate: 0 calc((var(--th) - var(--tb)) / 2); rotate: 45deg; }
  .is-morph .menu__toggle span:nth-child(2) { scale: 0 1; opacity: 0; }
  .is-morph .menu__toggle span:nth-child(3) { translate: 0 calc((var(--th) - var(--tb)) / -2); rotate: -45deg; }

  /* Items rise in with the §7 stagger after the panel starts moving. */
  .menu__item { opacity: 0; translate: 0 var(--m-menu-item-distance); transition: opacity var(--menu-close) ease, translate var(--menu-close) ease; }
  .is-open .menu__item {
    opacity: 1; translate: 0 0;
    --d: calc(var(--m-menu-item-delay) + var(--i, 0) * var(--m-menu-item-stagger));
    transition: opacity var(--m-menu-item-time) var(--m-menu-ease) var(--d), translate var(--m-menu-item-time) var(--m-menu-ease) var(--d);
  }

  /* Header row is as tall as the cross (it sits over the clicked button, so
     its position comes from --ty/--th/--tw): the links start below it plus
     the usual 28px, and "Menu" lines up with the cross's centre (owner).
     Cross half-height = half the bar length × sin 45° ≈ 0.36 × width. */
  .menu__head {
    display: flex; align-items: center; justify-content: space-between;
    min-height: calc(var(--ty, 0px) + var(--th, 0px) / 2 + var(--tw, 0px) * 0.36 - var(--menu-inset) - var(--menu-pad-top));
    margin-bottom: var(--space-7);
  }
  .menu__title { display: flex; align-items: center; gap: var(--gap-tight); color: var(--text-on-dark-strong); }

  .menu__dot { width: var(--menu-dot); height: var(--menu-dot); border-radius: var(--radius-pill); background: var(--bg-accent); }

  .menu__link {
    position: relative;
    isolation: isolate;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding-block: var(--menu-link-py);
    border-bottom: 1px solid var(--border-menu);
    color: var(--text-on-dark-strong);
    transition: color var(--m-hover-time) var(--m-hover-ease);
  }
  .menu__link[aria-current='page'] { color: var(--text-on-dark); }
  .menu__label { display: flex; align-items: baseline; gap: var(--menu-link-gap); min-width: 0; }
  .menu__index { color: var(--text-on-dark-tertiary); }
  .menu__text { letter-spacing: var(--ls-h3-lg); }
  /* Hover: a subtle white row background (bleeds 12px past the column so
     the text keeps its Figma position) + full-white text; the ↗ swaps. */
  .menu__link::before {
    content: '';
    position: absolute; z-index: -1;
    inset: 0 calc(var(--menu-link-hover-x) * -1);
    border-radius: var(--radius-sm);
    background: var(--menu-link-hover-bg);
    opacity: 0;
    transition: opacity var(--m-hover-time) var(--m-hover-ease);
  }
  .menu__link > * { position: relative; }
  @media (hover: hover) and (pointer: fine) {
    .menu__link:hover { color: var(--text-on-dark); }
    .menu__link:hover::before { opacity: 1; }
  }
  .menu__link:focus-visible { color: var(--text-on-dark); }
  .menu__link:focus-visible::before { opacity: 1; }

  .menu__spacer { flex: 1 0 var(--space-8); }

  .menu__offer {
    display: flex; align-items: center; gap: var(--menu-card-gap);
    padding: var(--space-3);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-lg);
    background: var(--glass-sm-bg);
    color: var(--text-on-dark);
  }
  .menu__offer :global(.menu__thumb) { width: var(--menu-thumb); height: var(--menu-thumb); flex: none; object-fit: cover; border-radius: var(--menu-thumb-radius); }
  .menu__offer-text { display: flex; flex-direction: column; gap: var(--space-1); flex: 1; min-width: 0; }
  .menu__offer-title { font-size: var(--fs-body); }
  .menu__offer-sub { color: var(--text-on-dark-secondary); line-height: var(--lh-snug); }

  .menu__cta { margin-top: var(--space-4); }

  .menu__contact {
    display: grid; grid-template-columns: 1fr 1fr;
    margin-top: var(--space-6); padding-top: var(--space-5);
    border-top: 1px solid var(--border-menu);
  }
  .menu__col { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .menu__col + .menu__col { padding-left: var(--space-5); border-left: 1px solid var(--border-menu); }
  .menu__col-label { display: flex; align-items: center; gap: var(--space-2); color: var(--text-on-dark-tertiary); }
  .menu__col-text { color: var(--text-on-dark-strong); }
  .menu__col-text a { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--m-hover-time); }
  @media (hover: hover) and (pointer: fine) { .menu__col-text a:hover { text-decoration-color: currentColor; } }
  .menu__col-text a:focus-visible { text-decoration-color: currentColor; }

  @media (max-width: 479px) {
    .menu__contact { grid-template-columns: 1fr; gap: var(--space-5); }
    .menu__col + .menu__col { padding-left: 0; border-left: 0; }
  }
</style>

<script>
  import { lockScroll } from '../../scripts/scroll';

  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (menu) {
    const panel = menu.querySelector<HTMLElement>('[role="dialog"]')!;
    const ghost = menu.querySelector<HTMLButtonElement>('[data-menu-ghost]')!;
    const toggles = () => document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]');
    const css = getComputedStyle(document.documentElement);
    const ms = (name: string) => parseFloat(css.getPropertyValue(name)) * (css.getPropertyValue(name).trim().endsWith('ms') ? 1 : 1000) || 0;
    let opener: HTMLElement | null = null;
    let closeTimer = 0;

    // Copy the clicked button's box onto the stand-in, and aim the panel's
    // circular reveal at the button's centre.
    const place = () => {
      const p = panel.getBoundingClientRect();
      let r: DOMRect;
      let bar = 2;
      let color = '';
      if (opener && opener.isConnected) {
        r = opener.getBoundingClientRect();
        const first = opener.querySelector('span');
        bar = first ? first.getBoundingClientRect().height : bar;
        color = getComputedStyle(opener).color;
      } else {
        // Opened without a button (e.g. programmatically): top-right of the panel.
        r = new DOMRect(p.right - 72, p.top + 28, 44, 24);
      }
      const set = (k: string, v: string) => menu.style.setProperty(k, v);
      set('--tx', `${r.left}px`); set('--ty', `${r.top}px`);
      set('--tw', `${r.width}px`); set('--th', `${r.height}px`); set('--tb', `${bar}px`);
      if (color) set('--tc', color);
      const cx = r.left + r.width / 2 - p.left;
      const cy = r.top + r.height / 2 - p.top;
      const far = Math.max(Math.hypot(cx, cy), Math.hypot(p.width - cx, cy), Math.hypot(cx, p.height - cy), Math.hypot(p.width - cx, p.height - cy));
      set('--cx', `${cx}px`); set('--cy', `${cy}px`); set('--cr', `${far + 80}px`); // +80 keeps the shadow
    };

    const focusables = () =>
      [...menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.offsetParent !== null || el === ghost);

    const setOpen = (open: boolean, returnFocus = true) => {
      window.clearTimeout(closeTimer);
      toggles().forEach((t) => {
        t.setAttribute('aria-expanded', String(open));
        t.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      if (open) {
        place();
        opener?.classList.add('is-menu-source');
        menu.inert = false;
        menu.classList.add('is-open');
        lockScroll(true);
        // Next frame: morph into the cross (the stand-in starts as the hamburger).
        requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-morph')));
        ghost.focus({ preventScroll: true });
      } else {
        menu.classList.remove('is-morph', 'is-open');
        menu.inert = true;
        lockScroll(false);
        const src = opener;
        if (returnFocus) src?.focus({ preventScroll: true });
        // Swap back to the real button once the cross is a hamburger again.
        closeTimer = window.setTimeout(() => src?.classList.remove('is-menu-source'), Math.max(ms('--m-burger-time'), ms('--m-menu-reveal-time') * 0.6));
      }
    };

    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      const toggle = target.closest<HTMLElement>('[data-menu-toggle]');
      if (toggle) {
        if (menu.classList.contains('is-open')) setOpen(false);
        else { opener = toggle; setOpen(true); }
      } else if (target.closest('[data-menu-close]')) setOpen(false);
    });
    // Following a link closes the menu without pulling focus back.
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false, false)));
    window.addEventListener('resize', () => { if (menu.classList.contains('is-open')) place(); });

    menu.addEventListener('keydown', (e) => {
      if (!menu.classList.contains('is-open')) return;
      if (e.key === 'Escape') { e.preventDefault(); setOpen(false); return; }
      if (e.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
    });
  }
</script>
